#!/usr/bin/python3 -I
"""Apply IPv4 settings for the Matrix dashboard settings menu (runs as root via sudo).

Usage:
  matrix-netcfg static ADDRESS/PREFIX GATEWAY DNS[,DNS...]
  matrix-netcfg dhcp

Only the IPv4 part of the interface is changed; IPv6 settings are kept.
After applying, the gateway must answer within 30 s, otherwise the previous
configuration is restored automatically. Prints one JSON line with the result.

The interface is the one holding the default route (or the only ethernet in
netplan), and the netplan file is the one under /etc/netplan that declares it.
Override with MATRIX_IFACE=... only when running it by hand as root.

Installed to /usr/local/sbin by install_hotkeys_sudo.sh (root-owned, so the
dashboard user cannot modify it). Requires netplan (Ubuntu Server) and python3-yaml.
"""

import fcntl
import glob
import ipaddress
import json
import os
import shutil
import subprocess
import sys
import time

import yaml

NETPLAN_DIR = "/etc/netplan"
IFACE = ""
NETPLAN = ""
LOCK = "/run/matrix-netcfg.lock"
GATEWAY_TIMEOUT = 30


def finish(ok: bool, message: str, **extra):
    print(json.dumps({"ok": ok, "message": message, **extra}, ensure_ascii=False))
    sys.exit(0 if ok else 2)


def fix_permissions():
    # netplan can leave generated files unreadable for systemd-networkd,
    # which leaves the link "unmanaged" (no DNS, broken after reboot).
    for path in glob.glob("/run/systemd/network/10-netplan-*"):
        shutil.chown(path, group="systemd-network")
        os.chmod(path, 0o640)


def apply_netplan():
    subprocess.run(["netplan", "generate"], check=True, capture_output=True)
    fix_permissions()
    subprocess.run(["netplan", "apply"], check=True, capture_output=True)
    fix_permissions()
    subprocess.run(["networkctl", "reload"], check=False, capture_output=True)
    subprocess.run(["networkctl", "reconfigure", IFACE], check=False, capture_output=True)


def wait_gateway(gateway: str | None) -> str | None:
    deadline = time.time() + GATEWAY_TIMEOUT
    while time.time() < deadline:
        gw = gateway
        if gw is None:
            route = subprocess.run(["ip", "-4", "route", "show", "default", "dev", IFACE],
                                   capture_output=True, text=True).stdout.split()
            gw = route[2] if len(route) > 2 and route[1] == "via" else None
        if gw and subprocess.run(["ping", "-4", "-c", "1", "-W", "1", gw],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            return gw
        time.sleep(1)
    return None


def build_config(cfg: dict, mode: str, address: str = "", gateway: str = "", dns: list[str] | None = None) -> dict:
    net = cfg.setdefault("network", {})
    net.setdefault("version", 2)
    eth = net.setdefault("ethernets", {}).setdefault(IFACE, {})
    ipv6_addrs = [a for a in eth.get("addresses", []) if ":" in str(a)]
    for key in ("gateway4", "routes", "addresses", "dhcp4", "nameservers"):
        eth.pop(key, None)
    eth["accept-ra"] = True
    if mode == "dhcp":
        eth["dhcp4"] = True
        if ipv6_addrs:
            eth["addresses"] = ipv6_addrs
    else:
        eth["dhcp4"] = False
        eth["addresses"] = [address] + ipv6_addrs
        eth["routes"] = [{"to": "default", "via": gateway}]
        eth["nameservers"] = {"addresses": dns or [gateway]}
    return cfg


def default_iface() -> str:
    try:
        with open("/proc/net/route") as f:
            for line in f.read().splitlines()[1:]:
                parts = line.split()
                if len(parts) > 2 and parts[1] == "00000000":
                    return parts[0]
    except OSError:
        pass
    return ""


def locate() -> tuple[str, str]:
    """(interface, netplan file that declares it); finishes with an error if not found."""
    if not os.path.isdir(NETPLAN_DIR) or not shutil.which("netplan"):
        finish(False, "este sistema não usa netplan: configure a rede pelo gerenciador da distribuição")
    files = sorted(glob.glob(os.path.join(NETPLAN_DIR, "*.yaml")) + glob.glob(os.path.join(NETPLAN_DIR, "*.yml")))
    declared: dict[str, str] = {}
    for path in files:
        try:
            with open(path) as f:
                data = yaml.safe_load(f) or {}
        except (OSError, yaml.YAMLError):
            continue
        for name in ((data.get("network") or {}).get("ethernets") or {}):
            declared.setdefault(str(name), path)
    wanted = os.environ.get("MATRIX_IFACE") if os.environ.get("SUDO_USER") is None else None
    iface = wanted or default_iface()
    if iface not in declared and len(declared) == 1:
        iface = next(iter(declared))
    if iface not in declared:
        finish(False, f"interface {iface or '?'} não encontrada em {NETPLAN_DIR}")
    if not os.path.exists(f"/sys/class/net/{iface}"):
        finish(False, f"interface {iface} não existe")
    return iface, declared[iface]


def main():
    global IFACE, NETPLAN
    if os.geteuid() != 0:
        finish(False, "precisa rodar como root (sudo)")
    IFACE, NETPLAN = locate()
    args = sys.argv[1:]
    if not args or args[0] not in ("static", "dhcp"):
        finish(False, "uso: matrix-netcfg static IP/PREFIXO GATEWAY DNS[,DNS] | dhcp")

    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        finish(False, "outra alteração de rede já está em andamento")

    mode = args[0]
    address = gateway = ""
    dns: list[str] = []
    if mode == "static":
        if len(args) != 4:
            finish(False, "uso: matrix-netcfg static IP/PREFIXO GATEWAY DNS[,DNS]")
        try:
            iface = ipaddress.IPv4Interface(args[1])
            gw = ipaddress.IPv4Address(args[2])
            dns = [str(ipaddress.ip_address(x.strip())) for x in args[3].split(",") if x.strip()]
        except ValueError as exc:
            finish(False, f"valor inválido: {exc}")
        net = iface.network
        if not 8 <= net.prefixlen <= 30:
            finish(False, "prefixo deve ficar entre 8 e 30")
        if iface.ip in (net.network_address, net.broadcast_address):
            finish(False, f"{iface.ip} é o endereço de rede/broadcast de {net}")
        if gw not in net or gw == iface.ip:
            finish(False, f"o gateway {gw} precisa estar na rede {net} e ser diferente do IP")
        if not 1 <= len(dns) <= 4:
            finish(False, "informe de 1 a 4 servidores DNS")
        address, gateway = str(iface), str(gw)

    with open(NETPLAN) as f:
        cfg = yaml.safe_load(f) or {}
    backup = f"{NETPLAN}.bak-matrix-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.copy2(NETPLAN, backup)

    new_cfg = build_config(cfg, mode, address, gateway, dns)
    tmp = NETPLAN + ".tmp"
    with open(tmp, "w") as f:
        yaml.safe_dump(new_cfg, f, default_flow_style=False, sort_keys=False)
    os.chmod(tmp, 0o600)
    os.replace(tmp, NETPLAN)

    try:
        apply_netplan()
        ok_gw = wait_gateway(gateway or None)
    except subprocess.CalledProcessError as exc:
        ok_gw = None
        err = (exc.stderr or b"").decode(errors="ignore").strip().splitlines()[-1:] or ["erro no netplan"]
        sys.stderr.write(err[0] + "\n")

    if not ok_gw:
        shutil.copy2(backup, NETPLAN)
        try:
            apply_netplan()
        except subprocess.CalledProcessError:
            pass
        finish(False, "o roteador não respondeu: configuração anterior restaurada", backup=backup)

    desc = "DHCP" if mode == "dhcp" else address
    finish(True, f"rede aplicada ({desc} via {ok_gw})", backup=backup)


if __name__ == "__main__":
    main()
